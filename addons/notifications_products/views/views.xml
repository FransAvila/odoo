<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='production_lot_info']" position="after">
                <block title="Notificaciones de Productos Nuevos" id="notifications_products_setting">
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                            <!-- Cmpo para seleccionar los usuarios-->
                                <label for="monitored_user_ids" style="font-weight: bold;"/>
                                <div class="text-muted">
                                    Usuarios monitoreados al crear productos.
                                </div>
                                <div class="content-group mt8">
                                    <field name="monitored_user_ids" 
                                           widget="many2many_tags"   
                                           options="{'no_create': True}"/>
                                </div>
                            </div>
                        </div>
                        <!-- Campo para escribir el correo de notificación -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="notification_email" style="font-weight: bold;"/>
                                <div class="text-muted">
                                    Correo que recibirá los informes de los nuevos productos.
                                </div>
                                <div class="content-group mt8">
                                    <field name="notification_email" 
                                           placeholder="ejemplo@empresa.com"/> 
                                </div>
                            </div>
                        </div>
                    </div> 
                </block> 
            </xpath>
        </field>
    </record> 
</odoo>